appname="hermes-desktop"
version="0.22.5"
display_name="Hermes Desktop"
desc="Hermes 官方 Desktop 工作区的飞牛原生版。完整保留桌面端 UI：对话流式输出、工具调用可视化、并排预览、文件浏览、Artifacts、定时任务、多 Profile、技能管理、终端栏、Git 审阅。基于官方 Webapp 形态（gateway 内建渲染层），无需 Electron，浏览器内即原生体验。"
platform="all"
source="thirdparty"

maintainer="fnOS Community"
maintainer_url="https://github.com/NousResearch/hermes-agent"
distributor="fnOS Community"
distributor_url="https://github.com/NousResearch/hermes-agent"

desktop_uidir="ui"
desktop_applaunchname="hermes-desktop.Application"
# 桌面入口走 fnOS 统一网关：iframe 的 src 落在 :5666 下（与飞牛桌面同源），
# 这样浏览器才会把会话 Cookie 一并带上 —— 若直接指向 :9120，跨源 iframe 里
# SameSite=lax 的 Cookie 不会发送，登录状态无法维持。
# 网关再把请求转到应用目录下的 app.sock，由网关适配层转给 Hermes。
service_port="9120"
checkport="false"
micro_app="true"
ctl_stop="true"
install_dep_apps="python312"
