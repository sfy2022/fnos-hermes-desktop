appname="hermes-desktop"
version="0.22.5"
display_name="Hermes Desktop"
desc="NousResearch 出品的 AI Agent 工作区，完整运行在飞牛 NAS 上。对话流式输出、工具调用可视化、并排预览、文件浏览、Artifacts、定时任务、多 Profile、技能管理、终端栏、Git 审阅一应俱全，内置飞牛 NAS 技能，装完即可操控本机。基于官方 Webapp 形态（gateway 内建渲染层），无需 Electron。支持浏览器直连与飞牛桌面内嵌两种入口。"
platform="all"
source="thirdparty"

maintainer="NousResearch"
maintainer_url="https://github.com/NousResearch/hermes-agent"
distributor="fnOS Community"
distributor_url="https://github.com/NousResearch/hermes-agent"

desktop_uidir="ui"
desktop_applaunchname="hermes-desktop.Application"
service_port="9120"
# 桌面内嵌入口走 fnOS 统一网关：iframe 的 src 落在 :5666 下（与飞牛桌面
# 同源），浏览器才会把会话 Cookie 一并带上；直接指向 :9120 属跨源，
# SameSite=lax 的 Cookie 不会发送，登录状态维持不住。
# 网关把 /app/hermes-desktop/* 转到应用目录下的 app.sock，由适配层转给 Hermes。
checkport="false"
micro_app="true"
ctl_stop="true"
install_dep_apps="python312"
