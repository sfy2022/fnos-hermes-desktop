#!/bin/bash
#
# 卸载前回调 — 停止服务
#
# 进程终止要点：
#   实际命令行形如
#     <TRIM_PKGVAR>/venv/bin/python3 -I -c "... runpy.run_module('hermes_cli.main') ... -p default gateway restart --interrupt"
#   "hermes" 与 "gateway" 之间隔着整段 runpy 代码，
#   因此 `pkill -f "hermes gateway"` 匹配不到，会留下僵尸进程继续占用端口与文件。
#   这里改为：先用 PID 文件精确终止，再用本应用 venv 路径做兜底匹配
#   （带路径前缀，不会误杀用户手动跑的其它 Hermes 实例）。

LOG_DIR="${TRIM_PKGVAR}"
LOG_FILE="${LOG_DIR}/info.log"
PID_FILE="${LOG_DIR}/app.pid"

log_msg() {
    mkdir -p "${LOG_DIR}" 2>/dev/null || true
    echo "$(date '+%Y-%m-%d %H:%M:%S') - [uninstall_init] $1" >> "${LOG_FILE}" 2>/dev/null || true
}

stop_app_processes() {
    # 0) 优先走 gateway 的官方控制接口做优雅停机。
    #    gateway 进程以应用专属用户 daemonize 运行（PPID=1），
    #    root 之外的账户即使同组也无法对它发信号，pkill 常常够不着。
    #    "pause-for-update" 会 drain 请求、停监听后自行退出，
    #    比 kill 干净，不会留下半开的数据库或 socket 文件。
    if [ -f "$(dirname "$0")/pause_gateway.py" ]; then
        python3 "$(dirname "$0")/pause_gateway.py" "${TRIM_PKGVAR}" 2>/dev/null || true
        sleep 2
    fi

    # 1) PID 文件精确终止
    if [ -f "${PID_FILE}" ]; then
        local pid
        pid="$(head -n 1 "${PID_FILE}" 2>/dev/null | tr -d '[:space:]')"
        if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
            kill -TERM "${pid}" 2>/dev/null || true
            local i=0
            while kill -0 "${pid}" 2>/dev/null && [ "${i}" -lt 10 ]; do
                sleep 1
                i=$((i + 1))
            done
            kill -KILL "${pid}" 2>/dev/null || true
        fi
        rm -f "${PID_FILE}" 2>/dev/null || true
    fi

    # 2) 兜底：只匹配本应用 venv 下的进程（带路径前缀，不会误杀其它实例）
    pkill -TERM -f "${TRIM_PKGVAR}/venv/bin" 2>/dev/null || true
    pkill -TERM -f "${TRIM_PKGVAR}.*gateway" 2>/dev/null || true
    sleep 2
    pkill -KILL -f "${TRIM_PKGVAR}/venv/bin" 2>/dev/null || true
    pkill -KILL -f "${TRIM_PKGVAR}.*gateway" 2>/dev/null || true
}

log_msg "卸载前停止服务"
stop_app_processes

# 卸载前先把值得留存的数据归档到存储卷根目录。
# fnOS 卸载会删除应用目录；即使用户选择保留数据，
# 这里也留一份"逃生通道"，万一之后手动清理了数据目录还能找回。
archive_dir="$(dirname "$(dirname "${TRIM_APPDEST}")")"
[ -d "${archive_dir}" ] || archive_dir="/vol1"
if [ -d "${TRIM_PKGVAR}" ] && [ -w "${archive_dir}" ]; then
    stamp="$(date +%Y%m%d-%H%M%S)"
    dest="${archive_dir}/hermes-desktop-backup-${stamp}"
    if mkdir -p "${dest}" 2>/dev/null; then
        for item in config.yaml access-info.txt fnos-skill-setup.txt state sessions \
                    backups channel_directory.json gateway_state.json; do
            [ -e "${TRIM_PKGVAR}/${item}" ] && cp -r "${TRIM_PKGVAR}/${item}" "${dest}/" 2>/dev/null || true
        done
        [ -d "${TRIM_PKGVAR}/.config" ] && cp -r "${TRIM_PKGVAR}/.config" "${dest}/" 2>/dev/null || true
        log_msg "数据已归档到 ${dest}"
    fi
fi

log_msg "卸载前已停止服务"
exit 0
