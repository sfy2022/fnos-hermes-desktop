#!/bin/bash
#
# Hermes Desktop（飞牛版）— 生命周期管理
#
#   start  : 启动 hermes gateway（内建 Webapp 渲染层，监听 9120）
#   stop   : 优雅停止
#   status : 运行中返回 0，未运行返回 3
#
# 架构说明：
#   官方 Desktop 的渲染层有两构建产物 —— Electron 包与 Webapp bundle。
#   本应用使用官方 Webapp 形态：gateway 在 webapp.port 上伺服打包进来的
#   渲染层（HERMES_WEBAPP_DIST 指向 app/webapp），桌面图标以 iframe 打开。
#   与官方 Windows/macOS Desktop 用的是同一套 UI 代码，仅承载方式不同。

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"

DATA_DIR="${TRIM_PKGVAR}"
VENV_DIR="${DATA_DIR}/venv"
HERMES_BIN="${VENV_DIR}/bin/hermes"
SRC_DIR="${DATA_DIR}/src"
WEBAPP_DIST="${TRIM_APPDEST}/webapp"
# fnOS 统一网关接入：应用在 Unix Socket 上提供 HTTP 服务，
# 由 fnOS 网关按 gatewayPrefix 转发过来，实现桌面图标内嵌窗口打开。
# 注意目录分工：
#   cmd/          → /var/apps/<app>/cmd/      （生命周期脚本，root）
#   TRIM_APPDEST  → /vol1/@appcenter/<app>/   （应用内容，应用用户）
# fnOS 网关按 manifest 的 gatewaySocket 在 TRIM_APPDEST 下找 socket。
GATEWAY_SOCKET="${TRIM_APPDEST}/app.sock"
GATEWAY_PREFIX="/app/hermes-desktop"
# 网关代理脚本位置。优先用数据目录下的副本（可热替换，便于排障时
# 直接改脚本而不必重装）；没有则用随包分发的 cmd/ 下的版本。
GATEWAY_PROXY="${DATA_DIR}/gateway_proxy.py"
if [ ! -f "${GATEWAY_PROXY}" ]; then
    GATEWAY_PROXY="$(cd "$(dirname "$0")" 2>/dev/null && pwd)/gateway_proxy.py"
fi
GATEWAY_PID_FILE="${DATA_DIR}/gateway-proxy.pid"
SERVICE_PORT="${TRIM_SERVICE_PORT:-9120}"
case "${SERVICE_PORT}" in
    ''|*[!0-9]*) SERVICE_PORT="9120" ;;
esac
FALLBACK_PORT=29220

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}" 2>/dev/null || true
}

toast_err() {
    if [ -n "${TRIM_TEMP_LOGFILE}" ]; then
        echo "$1" > "${TRIM_TEMP_LOGFILE}" 2>/dev/null || true
    fi
    log_msg "ERROR: $1"
}

# 判断端口是否已被占用。
# /proc/net/tcp 的格式：local_address 字段形如 "00000000:23A0"（地址:端口，无空格），
# 后面跟一个空格再是 remote_address。状态 0A = LISTEN。
# 注意不能写成 ":${hex_port}:" —— 本地端口与远端地址之间是空格而非冒号。
is_port_in_use() {
    local port="$1" hex_port
    hex_port=$(printf "%04X" "${port}")
    awk -v p="${hex_port}" '
        $4 == "0A" {
            split($2, a, ":")
            if (toupper(a[2]) == p) { found = 1; exit }
        }
        END { exit(found ? 0 : 1) }
    ' /proc/net/tcp /proc/net/tcp6 2>/dev/null
}

# 端口被占用时逐个探测备用端口，直到找到空闲的。
# 注意：SERVICE_PORT 只是环境变量，gateway 真正读的是 config.yaml 里的 webapp.port，
# 所以必须同步写回配置，否则改了变量也白改（gateway 仍会去抢被占用的端口）。
pick_port() {
    local cfg="${DATA_DIR}/config.yaml"
    local candidate

    # 首选：配置里已记录的端口（若它空闲就用它）
    if ! is_port_in_use "${SERVICE_PORT}"; then
        return 0
    fi

    # 该端口被别的服务占用（本机常见：另一个 Hermes 实例的 Docker 容器）
    log_msg "[端口] ${SERVICE_PORT} 已被其他服务占用，自动改用备用端口"

    for candidate in $(seq 29220 29259); do
        if ! is_port_in_use "${candidate}"; then
            SERVICE_PORT="${candidate}"
            log_msg "[端口] 改用 ${SERVICE_PORT}"
            break
        fi
    done

    if is_port_in_use "${SERVICE_PORT}"; then
        log_msg "[端口] 29220-29259 均被占用，仍使用 ${SERVICE_PORT}（启动可能失败）"
        return 1
    fi

    # 把新端口写回配置，让 gateway 真正用上
    if [ -f "${cfg}" ]; then
        sed -i "s/^\([[:space:]]*port:[[:space:]]*\)[0-9]\{1,5\}/\1${SERVICE_PORT}/" "${cfg}" 2>/dev/null || true
        # 若配置里没有 port 行（理论上不会），则补一行
        if ! grep -q "^[[:space:]]*port:[[:space:]]*${SERVICE_PORT}" "${cfg}" 2>/dev/null; then
            sed -i "s/^\([[:space:]]*host:[[:space:]]*0\.0\.0\.0\)/\1\n  port: ${SERVICE_PORT}/" "${cfg}" 2>/dev/null || true
        fi
        log_msg "[端口] 配置已同步为 ${SERVICE_PORT}"
    fi
    return 0
}

check_process() {
    local pid="$1"
    [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null
}

status() {
    if [ -f "${PID_FILE}" ]; then
        local pid
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        fi
        rm -f "${PID_FILE}"
    fi
    return 1
}

# 确保 webapp 配置存在（install_callback 已按向导写入；此处只做兜底）
ensure_webapp_config() {
    local cfg="${DATA_DIR}/config.yaml"
    mkdir -p "${DATA_DIR}" 2>/dev/null || true
    [ -f "${cfg}" ] || printf '# Hermes Agent 配置\n' > "${cfg}"

    if grep -q "^webapp:" "${cfg}" 2>/dev/null; then
        log_msg "config.yaml 已含 webapp 配置"
        return 0
    fi

    # 兜底：安装时未写入（异常情况），生成随机密码并落盘
    local pass
    pass="$(tr -dc 'A-Za-z0-9' < /dev/urandom 2>/dev/null | head -c 20)"
    [ -n "${pass}" ] || pass="$(date +%s | sha256sum | cut -c1-20)"

    cat >> "${cfg}" <<EOF

# ── 飞牛版 Hermes Desktop（兜底生成） ────────────────────
webapp:
  enabled: true
  host: 127.0.0.1
  port: ${SERVICE_PORT}

dashboard:
  basic_auth:
    username: admin
    password: "${pass}"
EOF
    chmod 600 "${cfg}" 2>/dev/null || true
    cat > "${DATA_DIR}/access-info.txt" <<EOF
Hermes Desktop（飞牛版）访问信息
================================
地址:     http://<本机IP>:${SERVICE_PORT}
用户名:   admin
密码:     ${pass}
EOF
    chmod 600 "${DATA_DIR}/access-info.txt" 2>/dev/null || true
    log_msg "已生成 webapp 配置与访问信息（见 ${DATA_DIR}/access-info.txt）"
}

SKILL_DIR="${DATA_DIR}/skills/fnos-trim"

# 启动时自愈：若 skills 目录被 Hermes postinstall 覆盖导致 Skill 丢失，
# 从安装目录（只读，随包分发）补回。
heal_fnos_skill() {
    [ -f "${SKILL_DIR}/SKILL.md" ] && return 0
    local src="${TRIM_APPDEST}/skills/fnos-trim"
    [ -d "${src}" ] || return 1
    log_msg "飞牛 Skill 缺失，从安装目录补回"
    mkdir -p "${DATA_DIR}/skills" 2>/dev/null || true
    rm -rf "${SKILL_DIR}" 2>/dev/null || true
    cp -r "${src}" "${SKILL_DIR}" 2>/dev/null || return 1
    local arch target
    arch="$(uname -m)"
    case "${arch}" in
    x86_64)  target="trim-cli-linux-x64" ;;
    aarch64) target="trim-cli-linux-arm64" ;;
    *)       target="" ;;
    esac
    if [ -n "${target}" ] && [ -f "${SKILL_DIR}/bin/${target}" ]; then
        find "${SKILL_DIR}/bin" -type f ! -name "${target}" -delete 2>/dev/null || true
        chmod +x "${SKILL_DIR}/bin/${target}" 2>/dev/null || true
    fi
    chmod +x "${SKILL_DIR}/scripts/trim-cli" 2>/dev/null || true
    log_msg "飞牛 Skill 已补回"
    return 0
}

# 启动 fnOS 统一网关适配层。
#
# fnOS 的桌面内嵌窗口（app/ui/config 的 type: iframe + gatewayPrefix）
# 要求应用在 Unix Socket 上提供 HTTP 服务：fnOS 网关把
# /app/hermes-desktop/* 转发到 app.sock。本函数拉起一个轻量代理，
# 剥离路径前缀后转给本机回环地址上的 Hermes gateway。
#
# 相比直连端口，这种方式的好处：
#   * 桌面图标直接内嵌打开，复用 fnOS 的登录态与统一入口
#   * Hermes 只监听 127.0.0.1，界面不再暴露在局域网的端口上
start_gateway_proxy() {
    if [ ! -f "${GATEWAY_PROXY}" ]; then
        log_msg "网关代理脚本缺失，跳过（${GATEWAY_PROXY}）"
        return 1
    fi

    # 已有实例在跑就不重复启动
    if [ -f "${GATEWAY_PID_FILE}" ]; then
        local gpid
        gpid="$(head -n 1 "${GATEWAY_PID_FILE}" 2>/dev/null | tr -d '[:space:]')"
        if [ -n "${gpid}" ] && check_process "${gpid}"; then
            log_msg "网关代理已在运行（PID=${gpid}）"
            return 0
        fi
        rm -f "${GATEWAY_PID_FILE}"
    fi

    rm -f "${GATEWAY_SOCKET}" 2>/dev/null || true
    mkdir -p "$(dirname "${GATEWAY_SOCKET}")" 2>/dev/null || true

    # 用 venv 里的 python（若有），否则用系统 python3
    local py="${VENV_DIR}/bin/python3"
    [ -x "${py}" ] || py="$(command -v python3 2>/dev/null)"
    if [ -z "${py}" ] || [ ! -x "${py}" ]; then
        log_msg "找不到可用的 python3，跳过网关代理"
        return 1
    fi

    log_msg "启动 fnOS 网关适配层（socket=${GATEWAY_SOCKET} → 127.0.0.1:${SERVICE_PORT}）"
    nohup "${py}" "${GATEWAY_PROXY}" \
        --socket "${GATEWAY_SOCKET}" \
        --upstream "127.0.0.1:${SERVICE_PORT}" \
        --prefix "${GATEWAY_PREFIX}" \
        >> "${DATA_DIR}/gateway-proxy.log" 2>&1 &

    local gpid=$!
    printf "%s" "${gpid}" > "${GATEWAY_PID_FILE}"

    # 等 socket 就绪
    local waited=0
    while [ "${waited}" -lt 15 ]; do
        if [ -S "${GATEWAY_SOCKET}" ]; then
            log_msg "网关适配层就绪（${GATEWAY_SOCKET}）"
            return 0
        fi
        if ! check_process "${gpid}"; then
            log_msg "网关适配层启动失败，日志尾部："
            tail -8 "${DATA_DIR}/gateway-proxy.log" 2>/dev/null | while IFS= read -r line; do
                log_msg "  ${line}"
            done
            rm -f "${GATEWAY_PID_FILE}"
            return 1
        fi
        sleep 1
        waited=$((waited + 1))
    done

    log_msg "网关适配层启动超时（socket 未出现）"
    return 1
}

start_process() {
    if status; then
        log_msg "Hermes Desktop 已在运行"
        return 0
    fi

    if [ ! -x "${HERMES_BIN}" ]; then
        toast_err "hermes 可执行文件缺失：${HERMES_BIN}，请重新安装应用。"
        return 1
    fi

    if [ ! -f "${WEBAPP_DIST}/index.html" ]; then
        toast_err "Webapp 渲染层缺失：${WEBAPP_DIST}/index.html，请重新安装应用。"
        return 1
    fi

    pick_port
    ensure_webapp_config
    heal_fnos_skill || log_msg "飞牛 Skill 补回失败（如需请手动安装官方 fnOS Skill）"

    # HERMES_HOME 指向应用数据目录：会话、技能、记忆、配置全部落在这里
    export HERMES_HOME="${DATA_DIR}"
    # 指向打包进来的官方渲染层，避免运行时自行构建（需要 Node 与源码）
    export HERMES_WEBAPP_DIST="${WEBAPP_DIST}"
    export PATH="${VENV_DIR}/bin:${PATH}"
    export PYTHONUNBUFFERED=1
    export PYTHONDONTWRITEBYTECODE=1

    mkdir -p "${DATA_DIR}/workspace" "${DATA_DIR}/logs" 2>/dev/null || true

    log_msg "启动 hermes gateway（Webapp 端口 ${SERVICE_PORT}）"
    log_msg "HERMES_HOME=${HERMES_HOME}"
    log_msg "HERMES_WEBAPP_DIST=${HERMES_WEBAPP_DIST}"

    # 工作目录必须是 HERMES_HOME，不能是源码目录。
    # 实测：在源码目录里跑 gateway 会让 Hermes 误判 project_root，
    # 导致 webapp 挂载失败（9120 端口不监听）。editable 安装已把源码
    # 写进 site-packages 的 .pth，任何目录都能 import hermes_cli。
    cd "${DATA_DIR}" || return 1

    nohup "${HERMES_BIN}" gateway run >> "${LOG_FILE}" 2>&1 &

    local pid=$!
    printf "%s" "${pid}" > "${PID_FILE}"
    log_msg "PID=${pid}"

    local waited=0
    while [ "${waited}" -lt 30 ]; do
        if ! check_process "${pid}"; then
            log_msg "进程已退出，日志尾部："
            tail -20 "${LOG_FILE}" 2>/dev/null | while IFS= read -r line; do
                log_msg "  ${line}"
            done
            toast_err "Hermes Desktop 启动失败，请查看 ${LOG_FILE}"
            rm -f "${PID_FILE}"
            return 1
        fi
        if is_port_in_use "${SERVICE_PORT}"; then
            log_msg "服务就绪，端口 ${SERVICE_PORT} 已监听"
            start_gateway_proxy
            return 0
        fi
        sleep 1
        waited=$((waited + 1))
    done

    log_msg "等待 ${waited}s 后未确认端口监听，但进程存活，继续运行"
    start_gateway_proxy
    return 0
}

stop_process() {
    log_msg "停止 Hermes Desktop ..."
    if [ -f "${PID_FILE}" ]; then
        local pid
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            kill -TERM "${pid}" >> "${LOG_FILE}" 2>&1
            local count=0
            while check_process "${pid}" && [ "${count}" -lt 15 ]; do
                sleep 1
                count=$((count + 1))
            done
            if check_process "${pid}"; then
                log_msg "优雅停止超时，强制结束"
                kill -KILL "${pid}" 2>/dev/null || true
                sleep 1
            fi
        fi
        rm -f "${PID_FILE}"
    fi
    # 兜底清理残留进程。
    # 注意：不能用 `pkill -f "hermes gateway"` —— 实际命令行里
    # "hermes" 与 "gateway" 之间隔着 runpy 代码，那样匹配不到，
    # 会留下进程继续占用 9120 端口。改用本应用 venv 路径匹配，
    # 带路径前缀也不会误杀用户手动跑的其它 Hermes 实例。
    # 网关适配层也要停，否则会一直占着 app.sock
    if [ -f "${GATEWAY_PID_FILE}" ]; then
        local gpid
        gpid="$(head -n 1 "${GATEWAY_PID_FILE}" 2>/dev/null | tr -d '[:space:]')"
        if [ -n "${gpid}" ] && check_process "${gpid}"; then
            kill -TERM "${gpid}" 2>/dev/null || true
            sleep 1
            kill -KILL "${gpid}" 2>/dev/null || true
        fi
        rm -f "${GATEWAY_PID_FILE}" 2>/dev/null || true
    fi
    pkill -TERM -f "gateway_proxy.py" 2>/dev/null || true
    pkill -TERM -f "${DATA_DIR}/venv/bin" 2>/dev/null || true
    pkill -TERM -f "${DATA_DIR}.*gateway" 2>/dev/null || true
    sleep 1
    pkill -KILL -f "gateway_proxy.py" 2>/dev/null || true
    pkill -KILL -f "${DATA_DIR}/venv/bin" 2>/dev/null || true
    pkill -KILL -f "${DATA_DIR}.*gateway" 2>/dev/null || true
    rm -f "${GATEWAY_SOCKET}" 2>/dev/null || true
    log_msg "已停止"
    return 0
}

case "$1" in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
restart)
    stop_process
    sleep 1
    start_process
    ;;
log)
    tail -n "${2:-100}" "${LOG_FILE}" 2>/dev/null
    ;;
setup-fnos)
    # 打印飞牛 Skill 的授权指引与当前状态
    if [ ! -d "${SKILL_DIR}" ]; then
        echo "未安装飞牛 Skill。请重新安装应用，或手动下载官方 fnOS Skill V2 并放入 ${DATA_DIR}/skills/" > "${TRIM_TEMP_LOGFILE}"
        exit 1
    fi
    chmod +x "${SKILL_DIR}/scripts/trim-cli" 2>/dev/null || true
    echo "=== 飞牛 Skill 状态 ==="
    echo "路径：${SKILL_DIR}"
    if [ -f "${DATA_DIR}/fnos-skill-setup.txt" ]; then
        cat "${DATA_DIR}/fnos-skill-setup.txt"
    fi
    echo
    echo "=== 当前授权状态 ==="
    "${SKILL_DIR}/scripts/trim-cli" +status 2>&1 | head -5
    ;;
*)
    echo "Usage: $0 {start|stop|status|restart|log|setup-fnos}" > "${TRIM_TEMP_LOGFILE}"
    exit 1
    ;;
esac
