#!/bin/bash
#
# Hermes Desktop（飞牛版）— 生命周期管理
#
#   start    : 启动 hermes gateway（内建 Webapp 渲染层，监听 9120）
#              并在 target/app.sock 上启动薄网关适配层（fnOS 统一网关入口）
#   stop     : 优雅停止 gateway 与适配层，清理 socket/PID
#   status   : 运行中返回 0，未运行返回 3
#   restart  : stop + start
#   log      : 打印运行日志尾部（默认 100 行）
#   diagnose : 诊断端口 / 适配层 / Socket / 两级 CSP / 日志尾部
#
# 架构（见 docs/REFACTOR-CONTRACT.md）：
#   iframe → fnOS 网关 → target/app.sock → gateway_adapter.py → 127.0.0.1:9120
#
#   官方 Desktop 的渲染层有两构建产物 —— Electron 包与 Webapp bundle。
#   本应用使用官方 Webapp 形态：gateway 在 webapp.port 上伺服打包进来的
#   渲染层（HERMES_WEBAPP_DIST 指向 target/webapp），桌面图标以 iframe 打开。
#   与官方 Windows/macOS Desktop 用的是同一套 UI 代码，仅承载方式不同。
#
#   网关适配层脚本随包分发在 target/runtime/gateway/（只读），
#   prefix / socket 名以 target/runtime/gateway/gateway.conf 为单一来源，
#   与 app/ui/config 的 gatewayPrefix / gatewaySocket 必须一致。
#
# 目录约定（contract §3.2）：
#   target/ 只读运行文件；etc/ 配置（0600）；var/ 运行数据（HERMES_HOME）；
#   HOME=TRIM_PKGHOME。脚本只通过 TRIM_* 变量定位目录，不硬编码 /var/apps。

LOG_FILE="${TRIM_PKGVAR}/info.log"
DATA_DIR="${TRIM_PKGVAR}"
ETC_DIR="${TRIM_PKGETC:-$(dirname "${DATA_DIR}")/etc}"
CONFIG_FILE="${ETC_DIR}/config.yaml"
ACCESS_INFO="${ETC_DIR}/access-info.txt"
APPSHARE_DIR="${TRIM_APPSHARE:-/vol1/@appshare/$(basename "${DATA_DIR}")}"
PID_FILE="${DATA_DIR}/app.pid"

VENV_DIR="${DATA_DIR}/venv"
HERMES_BIN="${VENV_DIR}/bin/hermes"
SRC_DIR="${DATA_DIR}/src"
WEBAPP_DIST="${TRIM_APPDEST}/webapp"

GATEWAY_CONF="${TRIM_APPDEST}/runtime/gateway/gateway.conf"
ADAPTER="${TRIM_APPDEST}/runtime/gateway/gateway_adapter.py"
ADAPTER_PID_FILE="${DATA_DIR}/gateway-adapter.pid"
ADAPTER_LOG="${DATA_DIR}/gateway-adapter.log"
ADAPTER_HEALTH_PATH="/.gateway-health"

SERVICE_PORT="${TRIM_SERVICE_PORT:-9120}"
case "${SERVICE_PORT}" in
    ''|*[!0-9]*) SERVICE_PORT="9120" ;;
esac

# prefix / socket 名由 gateway.conf 注入（单一来源）；解析失败时退回冻结值。
GATEWAY_PREFIX=""
GATEWAY_SOCKET_NAME=""
GATEWAY_SOCKET=""

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}" 2>/dev/null || true
}

toast_err() {
    if [ -n "${TRIM_TEMP_LOGFILE}" ]; then
        echo "$1" > "${TRIM_TEMP_LOGFILE}" 2>/dev/null || true
    fi
    log_msg "ERROR: $1"
}

# 读取 gateway.conf（key=value，仅认 prefix / socket_name）。
load_gateway_conf() {
    local key value
    if [ -f "${GATEWAY_CONF}" ]; then
        while IFS='=' read -r key value || [ -n "${key}" ]; do
            value="$(printf '%s' "${value}" | tr -d '[:space:]')"
            case "${key}" in
                prefix)      GATEWAY_PREFIX="${value}" ;;
                socket_name) GATEWAY_SOCKET_NAME="${value}" ;;
            esac
        done < "${GATEWAY_CONF}"
    fi
    # 兜底值与 app/ui/config 的 gatewayPrefix / gatewaySocket 保持一致
    [ -n "${GATEWAY_PREFIX}" ] || GATEWAY_PREFIX="/app/hermes-desktop"
    [ -n "${GATEWAY_SOCKET_NAME}" ] || GATEWAY_SOCKET_NAME="app.sock"
    GATEWAY_SOCKET="${TRIM_APPDEST}/${GATEWAY_SOCKET_NAME}"
}

# 判断端口是否已被占用。
# /proc/net/tcp 的格式：local_address 字段形如 "00000000:23A0"（地址:端口，无空格），
# 后面跟一个空格再是 remote_address。状态 0A = LISTEN。
# 注意不能写成 ":${hex_port}:" —— 本地端口与远端地址之间是空格而非冒号。
is_port_in_use() {
    local port="$1" hex_port
    hex_port=$(printf "%04X" "${port}")
    awk -v p="${hex_port}" '
        $4 == "0A" {
            split($2, a, ":")
            if (toupper(a[2]) == p) { found = 1; exit }
        }
        END { exit(found ? 0 : 1) }
    ' /proc/net/tcp /proc/net/tcp6 2>/dev/null
}

# 找出占用指定 TCP 端口的进程 PID（Linux，读 /proc）。
is_port_in_use_pids() {
    local port="$1"
    local inode="" pid="" fd="" link=""
    local hexport
    hexport=$(printf '%04X' "${port}")
    for f in /proc/net/tcp /proc/net/tcp6; do
        [ -r "$f" ] || continue
        while read -r _ local_addr _ _ _ _ _ _ _ inode_col _; do
            case "$local_addr" in
                *":${hexport}")
                    inode="${inode_col}"
                    [ -n "$inode" ] && [ "$inode" != "0" ] && printf '%s\n' "$inode"
                    ;;
            esac
        done < "$f"
    done | while read -r ino; do
        for d in /proc/[0-9]*; do
            pid="${d#/proc/}"
            for fd in "$d"/fd/*; do
                link=$(readlink "$fd" 2>/dev/null) || continue
                case "$link" in
                    *"socket:[${ino}]"*) printf '%s\n' "$pid"; break ;;
                esac
            done
        done
    done | sort -u
}

# 端口固定使用 SERVICE_PORT（manifest.service_port / 桌面入口一致）：
# 不换端口 —— 换了就与 app/ui/config 的 port、adapter 的 --upstream 对不上，
# 表现为「启动成功但端口不监听」→ fnOS 报「启动失败」。
# 这里只清理同 home 的残留 Hermes 进程；清不掉就明确失败，让用户处理占用者。
pick_port() {
    if ! is_port_in_use "${SERVICE_PORT}"; then
        return 0
    fi

    log_msg "[端口] ${SERVICE_PORT} 已被占用，尝试清理残留实例"

    local stale
    for stale in $(is_port_in_use_pids "${SERVICE_PORT}"); do
        log_msg "[端口] 结束残留进程 ${stale}"
        kill -TERM "${stale}" 2>/dev/null || true
    done
    sleep 3
    for stale in $(is_port_in_use_pids "${SERVICE_PORT}"); do
        kill -KILL "${stale}" 2>/dev/null || true
    done
    sleep 1

    if is_port_in_use "${SERVICE_PORT}"; then
        log_msg "[端口] ${SERVICE_PORT} 仍被占用，且不是本应用的残留实例"
        log_msg "[端口] 请先停用占用该端口的服务（可能是 Docker 容器），再启动本应用"
        return 1
    fi
    log_msg "[端口] 已清理，继续使用 ${SERVICE_PORT}"
    return 0
}

check_process() {
    local pid="$1"
    [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null
}

status() {
    if [ -f "${PID_FILE}" ]; then
        local pid
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        fi
        rm -f "${PID_FILE}"
    fi
    return 1
}

# fnOS“应用文件”展示 @appshare/<app>（config/resource 的 data-share）。
# 配置/日志/工作区实体迁移到这里，etc/var 只留符号链接；运行时数据仍在 @appdata。
ensure_appshare() {
    local share="${APPSHARE_DIR}"
    local f src dst name
    mkdir -p "${share}/config" "${share}/logs" "${share}/workspace" 2>/dev/null || return 0
    chmod 770 "${share}" "${share}/config" "${share}/logs" "${share}/workspace" 2>/dev/null || true

    for f in config.yaml access-info.txt gateway.conf; do
        src="${ETC_DIR}/${f}"
        dst="${share}/config/${f}"
        if [ -e "${src}" ] && [ ! -L "${src}" ]; then
            if [ ! -e "${dst}" ]; then
                mv -f "${src}" "${dst}" 2>/dev/null || true
            elif [ "${src}" -nt "${dst}" ]; then
                # etc 里的运行期配置更新（如运行期补写认证），以它为准确。
                mv -f "${src}" "${dst}" 2>/dev/null || true
            else
                rm -f "${src}" 2>/dev/null || true
            fi
        fi
        ln -sfn "${dst}" "${src}" 2>/dev/null || true
    done
    for name in logs workspace; do
        src="${DATA_DIR}/${name}"
        dst="${share}/${name}"
        if [ -d "${src}" ] && [ ! -L "${src}" ]; then
            if [ ! -e "${dst}" ]; then
                mv "${src}" "${dst}" 2>/dev/null || true
            else
                rm -rf "${src}" 2>/dev/null || true
            fi
        fi
        ln -sfn "${dst}" "${src}" 2>/dev/null || true
    done
    ln -sfn "${DATA_DIR}" "${share}/data" 2>/dev/null || true
    cat > "${share}/README.txt" <<EOF
Hermes Desktop 应用文件
=======================
- config/config.yaml       主配置（模型、webapp、认证）
- config/access-info.txt  访问账号
- logs/                    运行日志
- workspace/               Agent 工作区
data/ 指向 ${DATA_DIR}（venv/src/sessions 等运行时数据）。

修改配置后请在应用中心重启 Hermes。
EOF
    chmod 644 "${share}/README.txt" 2>/dev/null || true
    chmod 660 "${share}/config"/* 2>/dev/null || true
}

# etc / var 布局自愈：配置只放 etc，var 里用符号链接指回去（contract §3.2）。
ensure_home_layout() {
    mkdir -p "${DATA_DIR}" "${ETC_DIR}" 2>/dev/null || true
    # 与 fnOS 其它应用一致；700 会让应用中心的“应用数据”入口看不到目录内容。
    chmod 770 "${DATA_DIR}" 2>/dev/null || true

    # 旧布局迁移：var/config.yaml → etc/config.yaml，var 留符号链接。
    if [ -f "${DATA_DIR}/config.yaml" ] && [ ! -L "${DATA_DIR}/config.yaml" ]; then
        if [ ! -f "${CONFIG_FILE}" ]; then
            mv -f "${DATA_DIR}/config.yaml" "${CONFIG_FILE}" 2>/dev/null || true
            log_msg "已将 ${DATA_DIR}/config.yaml 迁移到 ${CONFIG_FILE}"
        else
            rm -f "${DATA_DIR}/config.yaml" 2>/dev/null || true
        fi
    fi
    if [ ! -e "${DATA_DIR}/config.yaml" ]; then
        ln -sfn "${CONFIG_FILE}" "${DATA_DIR}/config.yaml" 2>/dev/null || true
    fi
    ensure_appshare
}

# 确保 webapp 配置存在（install_callback 已按向导写入 etc；此处只做兜底）。
ensure_webapp_config() {
    local cfg="${CONFIG_FILE}"
    mkdir -p "${ETC_DIR}" 2>/dev/null || true
    [ -f "${cfg}" ] || printf '# Hermes Agent 配置\n' > "${cfg}"

    if grep -q "^webapp:" "${cfg}" 2>/dev/null; then
        # 已有 webapp 段：把端口同步成本次使用的端口。
        # 不同步会导致「配置里的端口」与「桌面入口/适配层使用的端口」不一致，
        # 典型症状就是启动后 ${SERVICE_PORT} 不监听、fnOS 报启动失败。
        local cfg_port
        cfg_port="$(sed -n '/^webapp:/,/^[^[:space:]]/p' "${cfg}" 2>/dev/null \
            | grep -E "^[[:space:]]*port:" | head -n 1 | grep -oE '[0-9]+')"
        if [ -n "${cfg_port}" ] && [ "${cfg_port}" != "${SERVICE_PORT}" ]; then
            sed -i --follow-symlinks "/^webapp:/,/^[^[:space:]]/ s/^\([[:space:]]*port:[[:space:]]*\)[0-9]\{1,5\}/\1${SERVICE_PORT}/" "${cfg}" 2>/dev/null || true
            log_msg "config.yaml 端口已从 ${cfg_port} 同步为 ${SERVICE_PORT}"
        else
            log_msg "config.yaml 已含 webapp 配置"
        fi
        return 0
    fi

    # 兜底：安装时未写入（异常情况），生成随机密码并落盘到 etc
    local pass
    pass="$(tr -dc 'A-Za-z0-9' < /dev/urandom 2>/dev/null | head -c 20)"
    [ -n "${pass}" ] || pass="$(date +%s | sha256sum | cut -c1-20)"

    cat >> "${cfg}" <<EOF

# ── 飞牛版 Hermes Desktop（兜底生成） ────────────────────
webapp:
  enabled: true
  host: 0.0.0.0
  port: ${SERVICE_PORT}

dashboard:
  basic_auth:
    username: admin
    password: "${pass}"
EOF
    chmod 600 "${cfg}" 2>/dev/null || true
    cat > "${ACCESS_INFO}" <<EOF
Hermes Desktop（飞牛版）访问信息
================================
地址:     http://<本机IP>:${SERVICE_PORT}
用户名:   admin
密码:     ${pass}
EOF
    chmod 600 "${ACCESS_INFO}" 2>/dev/null || true
    log_msg "已生成 webapp 配置与访问信息（见 ${ACCESS_INFO}）"
}

# 安装/升级早期 venv 尚未就绪时无法生成 scrypt 哈希，配置会回退到 127.0.0.1。
# 运行期（venv 已存在）补一次：从 etc/access-info.txt 取密码，补 basic_auth 并恢复 0.0.0.0。
finalize_webapp_auth() {
    local cfg="${CONFIG_FILE}"
    [ -f "${cfg}" ] || return 0
    local cur_host has_valid_hash=0
    cur_host="$(sed -n 's/^[[:space:]]*host:[[:space:]]*//p' "${cfg}" 2>/dev/null \
        | head -n 1 | tr -d '"[:space:]')"
    grep -qE '^[[:space:]]*password_hash:[[:space:]]*"?scrypt\$' "${cfg}" 2>/dev/null \
        && has_valid_hash=1

    if [ "${cur_host}" != "127.0.0.1" ] && [ "${cur_host}" != "localhost" ] \
            && [ "${has_valid_hash}" = "1" ]; then
        return 0
    fi
    [ -f "${ACCESS_INFO}" ] || return 0
    [ -x "${VENV_DIR}/bin/python3" ] || return 0

    local pass user hash
    pass="$(sed -n 's/^密码:[[:space:]]*//p' "${ACCESS_INFO}" 2>/dev/null | head -n 1)"
    user="$(sed -n 's/^用户名:[[:space:]]*//p' "${ACCESS_INFO}" 2>/dev/null | head -n 1)"
    [ -n "${pass}" ] || return 0
    [ -n "${user}" ] || user="admin"

    if [ "${has_valid_hash}" = "1" ]; then
        sed -i --follow-symlinks "s/^[[:space:]]*host:[[:space:]]*.*/  host: 0.0.0.0/" "${cfg}" 2>/dev/null || true
        log_msg "已有有效密码哈希，webapp 恢复绑定 0.0.0.0"
        return 0
    fi

    hash="$(HERMES_PW="${pass}" \
        env HOME="${TRIM_PKGHOME:-${DATA_DIR}}" \
            HERMES_HOME="${DATA_DIR}" \
            PYTHONPATH="${SRC_DIR}" \
            "${VENV_DIR}/bin/python3" -c \
            'import os; from plugins.dashboard_auth.basic import hash_password; print(hash_password(os.environ["HERMES_PW"]))' \
        2>>"${LOG_FILE}" | tail -n 1)"
    if [ -z "${hash}" ]; then
        log_msg "补写 dashboard.basic_auth 失败，保持 host=127.0.0.1"
        return 0
    fi

    sed -i --follow-symlinks "s/^[[:space:]]*host:[[:space:]]*.*/  host: 0.0.0.0/" "${cfg}" 2>/dev/null || true
    if grep -qE '^[[:space:]]*basic_auth:' "${cfg}" 2>/dev/null; then
        if grep -qE '^[[:space:]]*password_hash:' "${cfg}" 2>/dev/null; then
            sed -i --follow-symlinks "s|^\([[:space:]]*password_hash:\).*|\1 \"${hash}\"|" "${cfg}" 2>/dev/null || true
        else
            sed -i --follow-symlinks "/^[[:space:]]*basic_auth:/a\\    password_hash: \"${hash}\"" "${cfg}" 2>/dev/null || true
        fi
        log_msg "已补全空的 dashboard.basic_auth 哈希"
    else
        cat >> "${cfg}" <<EOF

# 认证提供方（运行期补写；绑 0.0.0.0 时必需）
dashboard:
  basic_auth:
    username: ${user}
    password_hash: "${hash}"
EOF
        log_msg "已补写 dashboard.basic_auth"
    fi
    chmod 600 "${cfg}" 2>/dev/null || true
    log_msg "webapp 恢复绑定 0.0.0.0"
}

SKILL_DIR="${DATA_DIR}/skills/fnos-trim"

# 启动时自愈：若 skills 目录被 Hermes postinstall 覆盖导致 Skill 丢失，
# 从安装目录（只读，随包分发）补回。
heal_fnos_skill() {
    [ -f "${SKILL_DIR}/SKILL.md" ] && return 0
    local src="${TRIM_APPDEST}/skills/fnos-trim"
    [ -d "${src}" ] || return 1
    log_msg "飞牛 Skill 缺失，从安装目录补回"
    mkdir -p "${DATA_DIR}/skills" 2>/dev/null || true
    rm -rf "${SKILL_DIR}" 2>/dev/null || true
    cp -r "${src}" "${SKILL_DIR}" 2>/dev/null || return 1
    local arch target
    arch="$(uname -m)"
    case "${arch}" in
    x86_64)  target="trim-cli-linux-x64" ;;
    aarch64) target="trim-cli-linux-arm64" ;;
    *)       target="" ;;
    esac
    if [ -n "${target}" ] && [ -f "${SKILL_DIR}/bin/${target}" ]; then
        find "${SKILL_DIR}/bin" -type f ! -name "${target}" -delete 2>/dev/null || true
        chmod +x "${SKILL_DIR}/bin/${target}" 2>/dev/null || true
    fi
    chmod +x "${SKILL_DIR}/scripts/trim-cli" 2>/dev/null || true
    log_msg "飞牛 Skill 已补回"
    return 0
}

# 适配层健康检查：优先 curl，没 curl 时用 python 直接走 Unix Socket。
adapter_healthy() {
    [ -S "${GATEWAY_SOCKET}" ] || return 1
    local health_url="http://localhost${GATEWAY_PREFIX}${ADAPTER_HEALTH_PATH}"

    if command -v curl >/dev/null 2>&1; then
        curl -sf -o /dev/null --max-time 3 --unix-socket "${GATEWAY_SOCKET}" \
            "${health_url}" 2>/dev/null
        return $?
    fi

    local py="${VENV_DIR}/bin/python3"
    [ -x "${py}" ] || py="$(command -v python3 2>/dev/null)"
    [ -n "${py}" ] || return 1

    "${py}" - "${GATEWAY_SOCKET}" "${GATEWAY_PREFIX}${ADAPTER_HEALTH_PATH}" <<'PY'
import socket
import sys

sock_path, path = sys.argv[1], sys.argv[2]
try:
    conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    conn.settimeout(3)
    conn.connect(sock_path)
    conn.sendall(
        ("GET %s HTTP/1.0\r\nHost: localhost\r\nConnection: close\r\n\r\n" % path).encode()
    )
    head = conn.recv(256).decode("latin-1", "replace")
    conn.close()
except OSError:
    sys.exit(1)
status_line = head.splitlines()[0] if head else ""
sys.exit(0 if " 200 " in status_line else 1)
PY
}

# 启动 fnOS 统一网关适配层。
#
# 为什么需要：桌面内嵌窗口要求 iframe 与飞牛桌面同源（:5666），
# 否则 SameSite=lax 的会话 Cookie 不会发送，登录状态无法维持。
# fnOS 网关只把 gatewayPrefix 转发到应用 target 目录的 Unix Socket，
# 因此应用要提供一个 HTTP-over-Unix-Socket 的转发层。
start_gateway_adapter() {
    if [ ! -f "${ADAPTER}" ]; then
        toast_err "网关适配层缺失：${ADAPTER}，请重新安装应用。"
        return 1
    fi

    if [ -f "${ADAPTER_PID_FILE}" ]; then
        local gpid
        gpid="$(head -n 1 "${ADAPTER_PID_FILE}" 2>/dev/null | tr -d '[:space:]')"
        if [ -n "${gpid}" ] && check_process "${gpid}"; then
            if adapter_healthy; then
                log_msg "网关适配层已在运行（PID=${gpid}）"
                return 0
            fi
            log_msg "网关适配层进程存在但健康检查失败，重启"
            kill -TERM "${gpid}" 2>/dev/null || true
            sleep 1
        fi
        rm -f "${ADAPTER_PID_FILE}" 2>/dev/null || true
    fi

    rm -f "${GATEWAY_SOCKET}" 2>/dev/null || true
    mkdir -p "$(dirname "${GATEWAY_SOCKET}")" 2>/dev/null || true

    local py="${VENV_DIR}/bin/python3"
    [ -x "${py}" ] || py="$(command -v python3 2>/dev/null)"
    if [ -z "${py}" ] || [ ! -x "${py}" ]; then
        toast_err "找不到可用的 python3，无法启动网关适配层。"
        return 1
    fi

    log_msg "启动网关适配层（socket=${GATEWAY_SOCKET} → 127.0.0.1:${SERVICE_PORT}，prefix=${GATEWAY_PREFIX}）"
    nohup "${py}" "${ADAPTER}" \
        --socket "${GATEWAY_SOCKET}" \
        --upstream "127.0.0.1:${SERVICE_PORT}" \
        --prefix "${GATEWAY_PREFIX}" \
        --health-path "${ADAPTER_HEALTH_PATH}" \
        >"${ADAPTER_LOG}" 2>&1 &

    local gpid=$!
    printf "%s" "${gpid}" > "${ADAPTER_PID_FILE}"

    local waited=0
    while [ "${waited}" -lt 15 ]; do
        if ! check_process "${gpid}"; then
            log_msg "网关适配层启动失败，日志尾部："
            tail -8 "${ADAPTER_LOG}" 2>/dev/null | while IFS= read -r line; do
                log_msg "  ${line}"
            done
            rm -f "${ADAPTER_PID_FILE}" "${GATEWAY_SOCKET}" 2>/dev/null || true
            return 1
        fi
        if [ -S "${GATEWAY_SOCKET}" ] && adapter_healthy; then
            log_msg "网关适配层就绪（${GATEWAY_SOCKET}）"
            return 0
        fi
        sleep 1
        waited=$((waited + 1))
    done

    log_msg "网关适配层未在 15s 内就绪（socket 或健康检查失败），详见 ${ADAPTER_LOG}"
    return 1
}

stop_gateway_adapter() {
    local gpid=""
    if [ -f "${ADAPTER_PID_FILE}" ]; then
        gpid="$(head -n 1 "${ADAPTER_PID_FILE}" 2>/dev/null | tr -d '[:space:]')"
        if [ -n "${gpid}" ] && check_process "${gpid}"; then
            log_msg "停止网关适配层（PID=${gpid}）"
            kill -TERM "${gpid}" 2>/dev/null || true
            local i=0
            while check_process "${gpid}" && [ "${i}" -lt 10 ]; do
                sleep 1
                i=$((i + 1))
            done
            check_process "${gpid}" && kill -KILL "${gpid}" 2>/dev/null || true
        fi
        rm -f "${ADAPTER_PID_FILE}" 2>/dev/null || true
    fi
    # 兜底：按随包 adapter 路径匹配（不会误杀其它进程）
    pkill -TERM -f "${ADAPTER}" 2>/dev/null || true
    sleep 1
    pkill -KILL -f "${ADAPTER}" 2>/dev/null || true
    rm -f "${GATEWAY_SOCKET}" 2>/dev/null || true
    log_msg "网关适配层已停止，socket 已清理"
}

start_process() {
    if status; then
        log_msg "Hermes Desktop 已在运行"
        # 旧会话可能只启动了 gateway（升级/异常），确保内嵌所需的 adapter 也在。
        start_gateway_adapter || log_msg "网关适配层未就绪（直连仍可用）"
        return 0
    fi

    if [ ! -x "${HERMES_BIN}" ]; then
        toast_err "hermes 可执行文件缺失：${HERMES_BIN}，请重新安装应用。"
        return 1
    fi

    if [ ! -f "${WEBAPP_DIST}/index.html" ]; then
        toast_err "Webapp 渲染层缺失：${WEBAPP_DIST}/index.html，请重新安装应用。"
        return 1
    fi

    ensure_home_layout
    pick_port || return 1
    ensure_webapp_config
    finalize_webapp_auth
    heal_fnos_skill || log_msg "飞牛 Skill 补回失败（如需请手动安装官方 fnOS Skill）"

    # HERMES_HOME 指向应用数据目录（var）：会话、技能、记忆、运行数据都在这里；
    # 配置实体在 etc/config.yaml，var/config.yaml 是指向它的符号链接。
    export HERMES_HOME="${DATA_DIR}"
    # HOME 指向应用自己的 home 目录。fnOS 注入的是 /home/<appname>，
    # 那个路径并不存在（真实目录是 /vol1/@apphome/<appname>），
    # 依赖会因此报错或退化到默认路径。
    export HOME="${TRIM_PKGHOME:-${DATA_DIR}}"
    # 指向打包进来的官方渲染层，避免运行时自行构建（需要 Node 与源码）
    export HERMES_WEBAPP_DIST="${WEBAPP_DIST}"
    export PATH="${VENV_DIR}/bin:${PATH}"
    export PYTHONUNBUFFERED=1
    export PYTHONDONTWRITEBYTECODE=1

    mkdir -p "${DATA_DIR}/workspace" "${DATA_DIR}/logs" 2>/dev/null || true

    log_msg "启动 hermes gateway（Webapp 端口 ${SERVICE_PORT}）"
    log_msg "HERMES_HOME=${HERMES_HOME}"
    log_msg "HERMES_WEBAPP_DIST=${HERMES_WEBAPP_DIST}"

    # 工作目录必须是 HERMES_HOME，不能是源码目录。
    # 实测：在源码目录里跑 gateway 会让 Hermes 误判 project_root，
    # 导致 webapp 挂载失败（9120 端口不监听）。editable 安装已把源码
    # 写进 site-packages 的 .pth，任何目录都能 import hermes_cli。
    cd "${DATA_DIR}" || return 1

    # --replace：接管 host。
    # 若上一次运行的 gateway 还残留（崩溃、被强杀、或手动启动过），
    # 不加这个参数时 Hermes 会拒绝启动并报：
    #   "A gateway already owns this host and has not published its served set yet."
    # 加了它就能干净地接管，避免应用「无法启用」。
    nohup "${HERMES_BIN}" gateway run --replace >> "${LOG_FILE}" 2>&1 &

    local pid=$!
    printf "%s" "${pid}" > "${PID_FILE}"
    log_msg "PID=${pid}"

    local waited=0
    while [ "${waited}" -lt 30 ]; do
        if ! check_process "${pid}"; then
            log_msg "进程已退出，日志尾部："
            tail -20 "${LOG_FILE}" 2>/dev/null | while IFS= read -r line; do
                log_msg "  ${line}"
            done
            toast_err "Hermes Desktop 启动失败，请查看 ${LOG_FILE}"
            rm -f "${PID_FILE}"
            return 1
        fi
        if is_port_in_use "${SERVICE_PORT}"; then
            log_msg "服务就绪，端口 ${SERVICE_PORT} 已监听"
            # 桌面内嵌入口需要网关适配层（target/app.sock）；网页直连 9120 不依赖它
            start_gateway_adapter
            return 0
        fi
        sleep 1
        waited=$((waited + 1))
    done

    log_msg "等待 ${waited}s 后未确认端口监听，但进程存活，继续运行"
    start_gateway_adapter
    return 0
}

stop_process() {
    log_msg "停止 Hermes Desktop ..."
    if [ -f "${PID_FILE}" ]; then
        local pid
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            kill -TERM "${pid}" >> "${LOG_FILE}" 2>&1
            local count=0
            while check_process "${pid}" && [ "${count}" -lt 15 ]; do
                sleep 1
                count=$((count + 1))
            done
            if check_process "${pid}"; then
                log_msg "优雅停止超时，强制结束"
                kill -KILL "${pid}" 2>/dev/null || true
                sleep 1
            fi
        fi
        rm -f "${PID_FILE}"
    fi

    # 网关适配层先停，避免它继续占着 app.sock
    stop_gateway_adapter

    # 兜底清理残留进程。
    # 注意：不能用 `pkill -f "hermes gateway"` —— 实际命令行里
    # "hermes" 与 "gateway" 之间隔着 runpy 代码，那样匹配不到，
    # 会留下进程继续占用 9120 端口。改用本应用 venv 路径匹配，
    # 带路径前缀也不会误杀用户手动跑的其它 Hermes 实例。
    pkill -TERM -f "${DATA_DIR}/venv/bin" 2>/dev/null || true
    pkill -TERM -f "${DATA_DIR}.*gateway" 2>/dev/null || true
    sleep 1
    pkill -KILL -f "${DATA_DIR}/venv/bin" 2>/dev/null || true
    pkill -KILL -f "${DATA_DIR}.*gateway" 2>/dev/null || true
    rm -f "${GATEWAY_SOCKET}" 2>/dev/null || true
    log_msg "已停止"
    return 0
}

# 取响应头中的某个字段（通过 curl；没有 curl 时返回空）。
http_header() {
    local header="$1"
    shift
    command -v curl >/dev/null 2>&1 || return 0
    curl -sSI --max-time 5 "$@" 2>/dev/null | tr -d '\r' \
        | awk -v h="${header}:" '
            tolower(substr($0, 1, length(h))) == h {
                sub(/^[^:]+:[[:space:]]*/, "")
                print
                exit
            }'
}

# diagnose：端口 / 适配层 / Socket / 两级 CSP / 日志尾部。
diagnose() {
    echo "Hermes Desktop 诊断"
    echo "  TRIM_APPDEST            : ${TRIM_APPDEST}"
    echo "  TRIM_PKGVAR             : ${TRIM_PKGVAR}"
    echo "  TRIM_PKGETC             : ${TRIM_PKGETC}"
    echo "  TRIM_PKGHOME            : ${TRIM_PKGHOME}"
    echo "  SERVICE_PORT            : ${SERVICE_PORT}"
    echo "  GATEWAY_PREFIX          : ${GATEWAY_PREFIX}"
    echo "  GATEWAY_SOCKET          : ${GATEWAY_SOCKET}"
    echo "  ADAPTER                 : ${ADAPTER}"
    echo "  gateway.conf            : ${GATEWAY_CONF}"
    echo ""

    echo "[1] hermes gateway 进程"
    if status; then
        echo "    运行中（PID=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')）"
    else
        echo "    未运行"
    fi

    echo "[2] 端口 ${SERVICE_PORT}"
    if is_port_in_use "${SERVICE_PORT}"; then
        echo "    监听中"
    else
        echo "    未监听（FAIL）"
    fi

    echo "[3] 网关适配层"
    local gpid=""
    [ -f "${ADAPTER_PID_FILE}" ] && gpid="$(head -n 1 "${ADAPTER_PID_FILE}" 2>/dev/null | tr -d '[:space:]')"
    if [ -n "${gpid}" ] && check_process "${gpid}"; then
        echo "    进程运行中（PID=${gpid}）"
    else
        echo "    进程未运行（FAIL）"
    fi
    if [ -S "${GATEWAY_SOCKET}" ]; then
        if adapter_healthy; then
            echo "    Socket 存在且健康检查通过：${GATEWAY_SOCKET}"
        else
            echo "    Socket 存在但健康检查失败：${GATEWAY_SOCKET}（FAIL）"
        fi
    else
        echo "    Socket 缺失：${GATEWAY_SOCKET}（FAIL）"
    fi

    echo "[4] 两级 CSP（直连 :${SERVICE_PORT} 应为 frame-ancestors 'none'；经网关应为 'self'）"
    local csp_direct csp_gateway xfo_direct xfo_gateway
    csp_direct="$(http_header content-security-policy "http://127.0.0.1:${SERVICE_PORT}/")"
    csp_gateway="$(http_header content-security-policy --unix-socket "${GATEWAY_SOCKET}" \
        "http://localhost${GATEWAY_PREFIX}/")"
    xfo_direct="$(http_header x-frame-options "http://127.0.0.1:${SERVICE_PORT}/")"
    xfo_gateway="$(http_header x-frame-options --unix-socket "${GATEWAY_SOCKET}" \
        "http://localhost${GATEWAY_PREFIX}/")"

    echo "    [直连] CSP              : ${csp_direct:-<无响应/无该头>}"
    echo "    [网关] CSP              : ${csp_gateway:-<无响应/无该头>}"
    echo "    [直连] X-Frame-Options  : ${xfo_direct:-<无响应/无该头>}"
    echo "    [网关] X-Frame-Options  : ${xfo_gateway:-<无响应/无该头>}"

    echo "[5] 日志尾部（${LOG_FILE}）"
    tail -n 10 "${LOG_FILE}" 2>/dev/null | while IFS= read -r line; do
        echo "    ${line}"
    done

    echo "[6] 适配层日志尾部（${ADAPTER_LOG}）"
    tail -n 10 "${ADAPTER_LOG}" 2>/dev/null | while IFS= read -r line; do
        echo "    ${line}"
    done

    return 0
}

load_gateway_conf

case "$1" in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
restart)
    stop_process
    sleep 1
    start_process
    ;;
log)
    tail -n "${2:-100}" "${LOG_FILE}" 2>/dev/null
    ;;
diagnose)
    diagnose
    ;;
setup-fnos)
    # 打印飞牛 Skill 的授权指引与当前状态
    if [ ! -d "${SKILL_DIR}" ]; then
        echo "未安装飞牛 Skill。请重新安装应用，或手动下载官方 fnOS Skill V2 并放入 ${DATA_DIR}/skills/" > "${TRIM_TEMP_LOGFILE}"
        exit 1
    fi
    chmod +x "${SKILL_DIR}/scripts/trim-cli" 2>/dev/null || true
    echo "=== 飞牛 Skill 状态 ==="
    echo "路径：${SKILL_DIR}"
    if [ -f "${DATA_DIR}/fnos-skill-setup.txt" ]; then
        cat "${DATA_DIR}/fnos-skill-setup.txt"
    fi
    echo
    echo "=== 当前授权状态 ==="
    "${SKILL_DIR}/scripts/trim-cli" +status 2>&1 | head -5
    ;;
*)
    echo "Usage: $0 {start|stop|status|restart|log|diagnose|setup-fnos}" > "${TRIM_TEMP_LOGFILE}"
    exit 1
    ;;
esac
