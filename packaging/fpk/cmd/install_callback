#!/bin/bash
#
# 安装后回调 — 部署 Hermes Agent 运行时（源码版，含 Webapp 支持）
#
# 实测结论（2026-11，Debian 12 / NAS）：
#   1. PyPI 上 hermes-agent 最高仅 0.19.0，且该版本没有 `hermes webapp` 子命令。
#      Webapp 是之后才加入的，必须装 GitHub 源码版（editable）。
#   2. 源码要求 Python 3.14（部分依赖按 python_version >= '3.14' 声明，
#      如 ruamel.yaml；3.11 环境会缺模块）。用 uv 自管 Python 3.14。
#   3. uv 0.13+ 默认带 exclude-newer（截止其构建日），且国内 PyPI 镜像
#      不携带 upload-time 元数据 → 依赖会被误判为"过新"而全部过滤。
#      必须用官方 PyPI 源 + 显式放宽 exclude-newer。
#
# 流程：装 uv → 拉源码 → Python 3.14 venv → editable 安装 → 校验

LOG_FILE="${TRIM_PKGVAR}/info.log"
DATA_DIR="${TRIM_PKGVAR}"
ETC_DIR="${TRIM_PKGETC:-$(dirname "${DATA_DIR}")/etc}"
CONFIG_FILE="${ETC_DIR}/config.yaml"
ACCESS_INFO="${ETC_DIR}/access-info.txt"
GATEWAY_CONF_SRC="${TRIM_APPDEST}/runtime/gateway/gateway.conf"
GATEWAY_CONF_ETC="${ETC_DIR}/gateway.conf"
VENV_DIR="${DATA_DIR}/venv"
UV_BIN="${DATA_DIR}/bin/uv"
SRC_DIR="${DATA_DIR}/src"
WEBAPP_DIST="${TRIM_APPDEST}/webapp"

# 源码版本标签；留空则用 main 分支
HERMES_REF="${HERMES_REF:-main}"

# 服务端口固定使用 manifest 的 service_port（与 app/ui/config、adapter 一致），
# 不再做端口顺延 —— 换端口会让桌面入口与网关适配层全部对不上。
SERVICE_PORT="${TRIM_SERVICE_PORT:-9120}"
case "${SERVICE_PORT}" in
    ''|*[!0-9]*) SERVICE_PORT="9120" ;;
esac

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - [install_callback] $1" >> "${LOG_FILE}" 2>/dev/null || true
}

toast_err() {
    if [ -n "${TRIM_TEMP_LOGFILE}" ]; then
        echo "$1" > "${TRIM_TEMP_LOGFILE}" 2>/dev/null || true
    fi
    log_msg "ERROR: $1"
}

# 生成随机强密码（无外部依赖）
gen_password() {
    if [ -r /dev/urandom ]; then
        tr -dc 'A-Za-z0-9' < /dev/urandom 2>/dev/null | head -c 20
    else
        date +%s | sha256sum | cut -c1-20
    fi
}

# ── etc / var 布局准备（REFACTOR-CONTRACT §3.2） ─────────────────────────
# 配置实体只放 etc（TRIM_PKGETC，0600）；var 只放运行数据，
# var/config.yaml 是指向 ../etc/config.yaml 的符号链接。
prepare_layout() {
    mkdir -p "${DATA_DIR}" "${ETC_DIR}" 2>/dev/null || true

    # 旧布局迁移：config.yaml 从 var 移到 etc，var 留符号链接。
    if [ -f "${DATA_DIR}/config.yaml" ] && [ ! -L "${DATA_DIR}/config.yaml" ]; then
        if [ ! -f "${CONFIG_FILE}" ]; then
            mv -f "${DATA_DIR}/config.yaml" "${CONFIG_FILE}" 2>/dev/null || true
            log_msg "已迁移旧配置 ${DATA_DIR}/config.yaml → ${CONFIG_FILE}"
        else
            rm -f "${DATA_DIR}/config.yaml" 2>/dev/null || true
            log_msg "etc 已有 config.yaml，清理 var 中的旧副本"
        fi
    fi
    if [ ! -e "${DATA_DIR}/config.yaml" ]; then
        ln -sfn "../etc/config.yaml" "${DATA_DIR}/config.yaml" 2>/dev/null || true
    fi

    # 访问信息同样归 etc
    if [ -f "${DATA_DIR}/access-info.txt" ] && [ ! -L "${DATA_DIR}/access-info.txt" ]; then
        if [ ! -f "${ACCESS_INFO}" ]; then
            mv -f "${DATA_DIR}/access-info.txt" "${ACCESS_INFO}" 2>/dev/null || true
        else
            rm -f "${DATA_DIR}/access-info.txt" 2>/dev/null || true
        fi
    fi

    # gateway.conf：单一来源是 target/runtime/gateway/，etc 留一份 0600 参考副本
    if [ -f "${GATEWAY_CONF_SRC}" ]; then
        cp -f "${GATEWAY_CONF_SRC}" "${GATEWAY_CONF_ETC}" 2>/dev/null || true
        chmod 600 "${GATEWAY_CONF_ETC}" 2>/dev/null || true
    fi

    # 旧网关代理脚本（本轮已删除）在数据目录的残留副本 / 日志 / pid
    rm -f "${DATA_DIR}/gateway_proxy.py" "${DATA_DIR}/fnos_bridge.py" \
          "${DATA_DIR}/gateway-proxy.pid" "${DATA_DIR}/gateway-proxy.log" 2>/dev/null || true
    # 旧版适配层 socket 残留（当前适配层监听 target/app.sock，启动时重建）
    rm -f "${TRIM_APPDEST}/app.sock" 2>/dev/null || true

    log_msg "布局就绪：etc=${ETC_DIR} var=${DATA_DIR}"
    return 0
}

# ── 处理安装向导输入 ────────────────────────────────────────────────────
# 向导变量（无 TRIM_ 前缀）在安装时以环境变量形式注入
apply_wizard_settings() {
    local cfg="${CONFIG_FILE}"
    local user="${wizard_web_user:-admin}"
    local pass="${wizard_web_pass:-}"

    if [ -z "${pass}" ]; then
        pass="$(gen_password)"
        log_msg "未设置密码，已生成随机密码"
    fi

    mkdir -p "${DATA_DIR}" "${ETC_DIR}" 2>/dev/null || true
    [ -f "${cfg}" ] || printf '# Hermes Agent 配置\n' > "${cfg}"

    # 只在缺失时追加，避免重复安装产生重复段落。
    #
    # 绑定地址与认证必须成对出现，否则应用装完起不来：
    #     host=127.0.0.1（回环）→ 上游 should_require_auth() 为假 → 免登录，
    #                              但只能本机访问，局域网打不开。
    #     host=0.0.0.0（对外）  → 上游强制要求认证提供方，否则拒绝启动 webapp：
    #         Refusing to bind dashboard to 0.0.0.0 — the auth gate engages on
    #         non-loopback binds, but no auth providers are registered
    #         There is no unauthenticated public-dashboard option. For local-only
    #         use, bind 127.0.0.1 ...
    #     此时 gateway 主循环照跑、进程活着，但端口不监听 —— 外部表现是
    #     「直连打不开」「内嵌 502」，日志里却只有一句 ERROR，很容易漏掉。
    #
    # 本应用要的是「局域网可用」，所以绑 0.0.0.0，并必须同时写出
    # dashboard.basic_auth。认证值是 password_hash（scrypt），不是明文。
    if ! grep -q "^webapp:" "${cfg}" 2>/dev/null; then

        # 生成 scrypt 密码哈希。密码经环境变量传入，避免引号与 shell 展开问题。
        local pw_hash=""
        if [ -x "${VENV_DIR}/bin/python3" ]; then
            pw_hash="$(HERMES_PW="${pass}" \
                env HOME="${TRIM_PKGHOME:-${DATA_DIR}}" \
                    HERMES_HOME="${DATA_DIR}" \
                    PYTHONPATH="${SRC_DIR}" \
                    "${VENV_DIR}/bin/python3" -c \
                    'import os; from plugins.dashboard_auth.basic import hash_password; print(hash_password(os.environ["HERMES_PW"]))' \
                2>>"${LOG_FILE}" | tail -n 1)"
        fi
        if [ -z "${pw_hash}" ]; then
            log_msg "警告：无法生成密码哈希，webapp 绑 0.0.0.0 时将无法启动"
            log_msg "  已回退为 host=127.0.0.1（仅本机可访问，局域网打不开）"
            local bind_host="127.0.0.1"
        else
            local bind_host="0.0.0.0"
        fi

        cat >> "${cfg}" <<EOF

# ── 飞牛版 Hermes Desktop（由安装向导生成） ─────────────
# host=0.0.0.0：允许局域网访问。非回环绑定必须配认证（见下方 dashboard 段），
# 否则 Hermes 拒绝启动 webapp —— gateway 主循环照跑但端口不监听。
webapp:
  enabled: true
  host: ${bind_host}
  port: ${SERVICE_PORT}
  public_url: ""

# 认证提供方（Hermes 要求 password_hash，不是明文密码）
dashboard:
  basic_auth:
    username: ${user}
    password_hash: "${pw_hash}"

# 启用内置插件：fnOS 授权面板 + fnos_auth_* 工具
plugins:
  enabled:
    - fnos-auth
EOF
        chmod 600 "${cfg}" 2>/dev/null || true
        log_msg "已写入 webapp 配置（host=${bind_host} port=${SERVICE_PORT}，basic_auth=$( [ -n "${pw_hash}" ] && echo 已配置 || echo 未配置 ))"
    else
        # 已有 webapp 段：逐项纠正。
        # 端口：与选定端口不一致时同步（端口冲突后顺延的情况）
        local cfg_port
        cfg_port="$(grep -E "^[[:space:]]*port:[[:space:]]*[0-9]+" "${cfg}" 2>/dev/null | head -n 1 | grep -oE '[0-9]+')"
        if [ -n "${cfg_port}" ] && [ "${cfg_port}" != "${SERVICE_PORT}" ]; then
            sed -i "s/^\([[:space:]]*port:[[:space:]]*\)[0-9]\{1,5\}/\1${SERVICE_PORT}/" "${cfg}" 2>/dev/null || true
            log_msg "config.yaml 端口已从 ${cfg_port} 更新为 ${SERVICE_PORT}"
        fi

        # public_url：非回环的 public_url 也会触发 gate
        if grep -qE '^[[:space:]]*public_url:[[:space:]]*"?[^"[:space:]]' "${cfg}" 2>/dev/null; then
            sed -i "s/^\([[:space:]]*public_url:[[:space:]]*\).*/\1\"\"/" "${cfg}" 2>/dev/null || true
            log_msg "config.yaml 的 webapp.public_url 已清空（避免触发认证 gate）"
        fi

        # 已有 webapp 段但绑的是 0.0.0.0、又缺认证 —— 补上 dashboard.basic_auth。
        # 升级场景常见：旧版本写的是回环绑定（免登录），新版本改成对外，
        # 但配置文件里没有认证，于是上游拒绝启动 webapp（端口不监听）。
        local cur_host
        cur_host="$(sed -n 's/^[[:space:]]*host:[[:space:]]*//p' "${cfg}" 2>/dev/null \
            | head -n 1 | tr -d '"[:space:]')"
        local has_basic
        has_basic="$(grep -cE '^[[:space:]]*basic_auth:' "${cfg}" 2>/dev/null || echo 0)"

        if [ "${cur_host}" != "127.0.0.1" ] && [ "${cur_host}" != "localhost" ] \
                && [ "${has_basic}" = "0" ]; then
            local pw_hash2=""
            if [ -x "${VENV_DIR}/bin/python3" ]; then
                pw_hash2="$(HERMES_PW="${pass}" \
                    env HOME="${TRIM_PKGHOME:-${DATA_DIR}}" \
                        HERMES_HOME="${DATA_DIR}" \
                        PYTHONPATH="${SRC_DIR}" \
                        "${VENV_DIR}/bin/python3" -c \
                        'import os; from plugins.dashboard_auth.basic import hash_password; print(hash_password(os.environ["HERMES_PW"]))' \
                    2>>"${LOG_FILE}" | tail -n 1)"
            fi
            if [ -n "${pw_hash2}" ]; then
                cat >> "${cfg}" <<EOF

# 认证提供方（由安装/升级流程补充；绑非回环地址时必需）
dashboard:
  basic_auth:
    username: ${user}
    password_hash: "${pw_hash2}"
EOF
                chmod 600 "${cfg}" 2>/dev/null || true
                log_msg "config.yaml 已补充 dashboard.basic_auth（host=${cur_host} 需要认证）"
            else
                # 补不上认证就退回回环，至少让应用能起来
                sed -i "s/^\([[:space:]]*host:[[:space:]]*\).*/\1127.0.0.1/" "${cfg}" 2>/dev/null || true
                log_msg "警告：无法生成密码哈希，已回退 host=127.0.0.1（仅本机可访问）"
            fi
        fi
    fi

    # 网关适配层随包分发给 target/runtime/gateway/（只读运行期组件，见
    # REFACTOR-CONTRACT §3.1），安装期不再复制到数据目录。
    # 旧版本曾把 gateway_proxy.py / fnos_bridge.py 部署到数据目录，
    # 这两个脚本已删除，迁移时由 install/upgrade 回调清理残留副本。

    # 把访问信息单独存一份到 etc（0600），便于用户查阅
    local info="${ACCESS_INFO}"
    cat > "${info}" <<EOF
Hermes Desktop（飞牛版）访问信息
================================
地址:     http://<本机IP>:${SERVICE_PORT}
用户名:   ${user}
密码:     ${pass}

说明：
- 飞牛桌面上的「Hermes Desktop」图标点击后会在浏览器打开上面的地址。
- 上游对非回环绑定强制启用认证（防止局域网内未授权访问），
  因此需要输入上面这组账号密码。
- 密码可通过编辑 ${cfg} 中的 dashboard.basic_auth 修改，改后需重启应用。
EOF
    chmod 600 "${info}" 2>/dev/null || true
    log_msg "访问信息已写入 ${info}"

    # 导出给后续步骤使用
    HERMES_WEB_USER="${user}"
    HERMES_WEB_PASS="${pass}"
}

# ── 安装 uv ───────────────────────────────────────────────────────────────
# 说明：uv 的发行物文件名带版本号且各源结构不同，不能拼固定 URL。
# 策略：先从 PyPI 索引页解析出匹配当前架构的真实链接并下载；
#       索引不可用时回退 GitHub release tarball。
ensure_uv() {
    if [ -x "${UV_BIN}" ]; then
        log_msg "uv 已存在：${UV_BIN}"
        return 0
    fi

    mkdir -p "${DATA_DIR}/bin" "${DATA_DIR}/.uv-cache" 2>/dev/null || true

    local arch uv_target
    arch="$(uname -m)"
    case "${arch}" in
    x86_64)  uv_target="x86_64-unknown-linux-gnu" ;;
    aarch64) uv_target="aarch64-unknown-linux-gnu" ;;
    armv7l)  uv_target="armv7-unknown-linux-gnueabihf" ;;
    *)
        toast_err "不支持的架构：${arch}"
        return 1
        ;;
    esac

    # ── 方式一：PyPI JSON API 精确定位最新版 linux wheel ──
    # 各源的索引页命名与格式不一致，解析容易出错；JSON API 返回结构化结果，最稳。
    local arch_tag
    case "${arch}" in
    x86_64)  arch_tag="x86_64" ;;
    aarch64) arch_tag="aarch64" ;;
    armv7l)  arch_tag="armv7l" ;;
    esac

    log_msg "通过 PyPI JSON API 定位 uv 安装包 ..."
    local meta="${DATA_DIR}/.uv-cache/uv.json"
    if curl -sL --fail --max-time 40 --http1.1 -o "${meta}" \
        "https://pypi.org/pypi/uv/json" 2>>"${LOG_FILE}"; then
        local url
        url="$(python3 -c "
import json,sys
try:
    d=json.load(open('${meta}'))
except Exception:
    sys.exit(0)
v=d['info']['version']
for f in d['releases'].get(v,[]):
    fn=f['filename']
    if '${arch_tag}' in fn and 'linux' in fn and 'manylinux' in fn and 'musllinux' not in fn:
        print(f['url']); break
" 2>>"${LOG_FILE}")"

        if [ -n "${url}" ]; then
            log_msg "下载 uv：${url}"
            if curl -sL --fail --retry 2 --max-time 240 --http1.1 \
                -o "${DATA_DIR}/.uv-cache/uv.whl" "${url}" 2>>"${LOG_FILE}"; then
                if command -v unzip >/dev/null 2>&1; then
                    unzip -o -j "${DATA_DIR}/.uv-cache/uv.whl" '*/uv' -d "${DATA_DIR}/bin" >>"${LOG_FILE}" 2>&1
                else
                    python3 -c "
import zipfile
z=zipfile.ZipFile('${DATA_DIR}/.uv-cache/uv.whl')
names=[n for n in z.namelist() if n.endswith('/uv') or n=='uv']
if names:
    open('${DATA_DIR}/bin/uv','wb').write(z.read(sorted(names,key=len)[0]))
" >>"${LOG_FILE}" 2>&1 || true
                fi
                chmod +x "${UV_BIN}" 2>/dev/null || true
            fi
        fi
    fi

    # ── 方式二：回退 GitHub release tarball ──
    if [ ! -x "${UV_BIN}" ]; then
        log_msg "JSON API 方式未成功，回退 GitHub tarball ..."
        local tarball="${DATA_DIR}/.uv-cache/uv.tar.gz"
        if curl -sL --fail --retry 2 --retry-delay 3 --max-time 240 --http1.1 \
            -o "${tarball}" \
            "https://github.com/astral-sh/uv/releases/latest/download/uv-${uv_target}.tar.gz" 2>>"${LOG_FILE}"; then
            mkdir -p "${DATA_DIR}/.uvx" 2>/dev/null || true
            tar xzf "${tarball}" -C "${DATA_DIR}/.uvx" >>"${LOG_FILE}" 2>&1
            local found
            found="$(find "${DATA_DIR}/.uvx" -type f -name uv 2>/dev/null | head -n 1)"
            if [ -n "${found}" ]; then
                cp -f "${found}" "${UV_BIN}" 2>/dev/null || true
                chmod +x "${UV_BIN}" 2>/dev/null || true
            fi
        fi
    fi

    if [ ! -x "${UV_BIN}" ]; then
        toast_err "uv 安装失败，请检查网络或代理设置。"
        return 1
    fi

    log_msg "uv 安装完成：$(${UV_BIN} --version 2>&1)"
    return 0
}

# ── 拉取源码 ─────────────────────────────────────────────────────────────
fetch_source() {
    if [ -f "${SRC_DIR}/hermes_cli/webapp.py" ]; then
        log_msg "源码已存在，跳过下载"
        return 0
    fi

    mkdir -p "${DATA_DIR}" 2>/dev/null || true
    rm -rf "${SRC_DIR}" 2>/dev/null || true

    log_msg "获取 hermes-agent 源码（${HERMES_REF}）..."
    # NAS 到 github.com 常不稳定（443 超时），按向导选择与自动探测组合多个来源
    local gh_mode="${wizard_github_proxy:-auto}"

    if [ "${gh_mode}" = "auto" ] || [ "${gh_mode}" = "direct" ]; then
        if command -v git >/dev/null 2>&1; then
            log_msg "尝试 git clone ..."
            timeout 300 git -c http.version=HTTP/1.1 clone --depth 1 --branch "${HERMES_REF}" \
                https://github.com/NousResearch/hermes-agent.git "${SRC_DIR}" >>"${LOG_FILE}" 2>&1
        fi
    fi

    if [ ! -f "${SRC_DIR}/hermes_cli/webapp.py" ]; then
        rm -rf "${SRC_DIR}" 2>/dev/null || true
        local tgz="${DATA_DIR}/.uv-cache/src.tar.gz"
        local urls=()
        case "${gh_mode}" in
        ghproxy)     urls=("https://gh-proxy.com/https://github.com/NousResearch/hermes-agent/archive/refs/heads/${HERMES_REF}.tar.gz") ;;
        ghproxy_net) urls=("https://ghproxy.net/https://github.com/NousResearch/hermes-agent/archive/refs/heads/${HERMES_REF}.tar.gz") ;;
        codeload)    urls=("https://codeload.github.com/NousResearch/hermes-agent/tar.gz/refs/heads/${HERMES_REF}") ;;
        direct)      urls=("https://github.com/NousResearch/hermes-agent/archive/refs/heads/${HERMES_REF}.tar.gz") ;;
        *)           urls=(
                        "https://codeload.github.com/NousResearch/hermes-agent/tar.gz/refs/heads/${HERMES_REF}"
                        "https://gh-proxy.com/https://github.com/NousResearch/hermes-agent/archive/refs/heads/${HERMES_REF}.tar.gz"
                        "https://ghproxy.net/https://github.com/NousResearch/hermes-agent/archive/refs/heads/${HERMES_REF}.tar.gz"
                        "https://github.com/NousResearch/hermes-agent/archive/refs/heads/${HERMES_REF}.tar.gz"
                     ) ;;
        esac
        local u
        for u in "${urls[@]}"; do
            log_msg "下载源码：$(echo "${u}" | cut -d/ -f3)"
            if curl -sL --fail --retry 2 --retry-delay 3 --max-time 600 --http1.1 \
                -o "${tgz}" "${u}" 2>>"${LOG_FILE}" && [ -s "${tgz}" ]; then
                mkdir -p "${DATA_DIR}/srcx" 2>/dev/null || true
                tar xzf "${tgz}" -C "${DATA_DIR}/srcx" >>"${LOG_FILE}" 2>&1
                local sub
                sub="$(find "${DATA_DIR}/srcx" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | head -n 1)"
                if [ -n "${sub}" ]; then
                    mv "${sub}" "${SRC_DIR}" 2>/dev/null || true
                fi
                if [ -f "${SRC_DIR}/hermes_cli/webapp.py" ]; then
                    log_msg "源码下载成功（$(echo "${u}" | cut -d/ -f3)）"
                    break
                fi
            fi
            rm -f "${tgz}" 2>/dev/null || true
        done
    fi

    if [ ! -f "${SRC_DIR}/hermes_cli/webapp.py" ]; then
        toast_err "源码下载失败，请检查 GitHub 访问或代理设置。"
        return 1
    fi

    log_msg "源码就绪：${SRC_DIR}"
    return 0
}

# ── 安装（关键：Python 3.14 + 官方源 + 放宽 exclude-newer） ──────────────
install_hermes() {
    # 预置缺失的运行时库（fnOS 没有 libatomic.so.1，pm 装 node 会失败）。
    # libs.sh 已按 REFACTOR-CONTRACT §3.1 移到只读的 target/runtime/lib/。
    local libs_sh="${TRIM_APPDEST}/runtime/lib/libs.sh"
    if [ -f "${libs_sh}" ]; then
        . "${libs_sh}"
        ensure_libatomic || true
    else
        log_msg "警告：未找到运行时库脚本 ${libs_sh}（跳过 libatomic 预置）"
    fi

    # HOME 必须指向应用自己的 home 目录。
    # fnOS 注入的 HOME 是 /home/<appname>，那个路径并不存在（真实目录是
    # /vol1/@apphome/<appname>），pm 会因此报
    #   PermissionError: [Errno 13] Permission denied: '/home/hermes-desktop'
    # 而失败回退到 uv —— 既装上了用不到的 chromium 等重依赖（慢），
    # 又丢掉了 pm 自动剥离 exclude-newer 的好处。
    export HOME="${TRIM_PKGHOME:-${DATA_DIR}}"
    export UV_CACHE_DIR="${DATA_DIR}/.uv-cache"
    export UV_PYTHON_INSTALL_DIR="${DATA_DIR}/pythons"
    # PyPI 源选择。pm 路径会自动剥离 exclude-newer，因此镜像缺
    # upload-time 元数据也能装（上游 issue #135589）；uv 回退路径仍需
    # 完整元数据，默认用官方源最稳。
    case "${wizard_pypi_index:-official}" in
    tuna)   export UV_INDEX_URL="https://pypi.tuna.tsinghua.edu.cn/simple" ;;
    aliyun) export UV_INDEX_URL="https://mirrors.aliyun.com/pypi/simple" ;;
    *)      export UV_INDEX_URL="https://pypi.org/simple" ;;
    esac
    log_msg "PyPI 源：${UV_INDEX_URL}"

    if [ ! -x "${VENV_DIR}/bin/hermes" ]; then
        log_msg "创建 Python 3.14 虚拟环境 ..."
        "${UV_BIN}" venv --clear --python 3.14 "${VENV_DIR}" >>"${LOG_FILE}" 2>&1
        # 兜底：uv 版本过旧不支持 --clear 时，先清掉残留的 venv。
    # 卸载中断或用户选择保留数据时，venv 目录会残留，
    # 导致 uv 报 "A directory already exists at .../venv" 安装失败。
    if [ -d "${VENV_DIR}" ] && [ ! -x "${VENV_DIR}/bin/python3" ]; then
        log_msg "检测到不完整的 venv 残留，先清理"
        rm -rf "${VENV_DIR}" 2>/dev/null || true
    fi

    if [ ! -x "${VENV_DIR}/bin/python3" ]; then
            log_msg "Python 3.14 创建失败，回退 3.12"
            "${UV_BIN}" venv --clear --python 3.12 "${VENV_DIR}" >>"${LOG_FILE}" 2>&1
        fi
        if [ ! -x "${VENV_DIR}/bin/python3" ]; then
            toast_err "创建虚拟环境失败：$(tail -3 "${LOG_FILE}" 2>/dev/null)"
            return 1
        fi
        log_msg "Python 版本：$("${VENV_DIR}/bin/python3" --version 2>&1)"
    fi

    # 优先用官方包管理器 pm 安装。
    # 为什么不直接用 uv pip install：
    #   * pm 会按 pm/lock.json 做哈希校验锁定依赖版本
    #   * pm 在生成的 workspace 里主动剥离 [tool.uv] exclude-newer
    #     （上游 pm/workspace.py::_without_release_age），因此不需要
    #     国内镜像提供 upload-time 元数据 —— 这正是原先依赖被全部
    #     过滤掉的根因（上游 issue #135589）
    #   * pm 会一并处理可执行入口发布、附加包等收尾工作
    # NAS 上不需要浏览器与计算机视觉驱动，用 --without 跳过，省空间也省时间。
    local pm_ok=0
    if [ -d "${SRC_DIR}/pm" ]; then
        log_msg "使用官方 pm 安装依赖（跳过 chromium 浏览器与 cua-driver 视觉驱动）..."
        ( cd "${SRC_DIR}" && "${VENV_DIR}/bin/python3" -m pm.cli install \
            --without chromium --without cua-driver ) >>"${LOG_FILE}" 2>&1 && pm_ok=1
        if [ "${pm_ok}" != "1" ]; then
            log_msg "pm install 未成功，回退 uv（详见 ${LOG_FILE}）"
        fi
    else
        log_msg "源码中无 pm 模块，回退 uv 安装"
    fi

    if [ "${pm_ok}" != "1" ]; then
        # 回退路径：直接用 uv。显式放宽 exclude-newer（uv 默认按自身构建日
        # 截断，会误伤刚发布的依赖版本），并强制走完整 upload-time 元数据的源。
        local EXCLUDE="--exclude-newer 2027-01-01"
        log_msg "editable 安装 hermes-agent[web] ..."
        ( cd "${SRC_DIR}" && "${UV_BIN}" pip install --python "${VENV_DIR}/bin/python3" \
            ${EXCLUDE} -e ".[web]" ) >>"${LOG_FILE}" 2>&1
    fi

    if [ ! -x "${VENV_DIR}/bin/hermes" ]; then
        log_msg "web extra 安装失败，尝试 all extra ..."
        ( cd "${SRC_DIR}" && "${UV_BIN}" pip install --python "${VENV_DIR}/bin/python3" \
            --exclude-newer 2027-01-01 -e ".[all]" ) >>"${LOG_FILE}" 2>&1
    fi

    if [ ! -x "${VENV_DIR}/bin/hermes" ]; then
        toast_err "hermes-agent 安装失败，请查看 ${LOG_FILE}"
        return 1
    fi

    # webapp 子命令是本应用的前提，必须存在
    if ! "${VENV_DIR}/bin/hermes" webapp --help >/dev/null 2>&1; then
        toast_err "安装的版本缺少 webapp 子命令，无法提供 Desktop 界面。"
        return 1
    fi

    log_msg "安装成功：$("${VENV_DIR}/bin/hermes" --version 2>&1 | head -n 1)"
    return 0
}

# ── 校验 Webapp 渲染层 ──────────────────────────────────────────────────
verify_webapp() {
    if [ ! -f "${WEBAPP_DIST}/index.html" ]; then
        toast_err "Webapp 渲染层不完整（缺少 index.html），请重新下载安装包。"
        return 1
    fi
    local count
    count="$(find "${WEBAPP_DIST}" -type f 2>/dev/null | wc -l)"
    log_msg "Webapp 渲染层校验通过：${count} 个文件"
    if [ "${count}" -lt 100 ]; then
        toast_err "Webapp 渲染层文件异常（仅 ${count} 个），请重新下载安装包。"
        return 1
    fi
    return 0
}

# ── 部署内置飞牛 Skill ──────────────────────────────────────────────────
# Hermes 从 HERMES_HOME/skills 加载技能（上游 get_skills_dir()）。
# 本应用的 HERMES_HOME 即 TRIM_PKGVAR，所以装到 ${TRIM_PKGVAR}/skills/。
# ── 部署 fnOS 授权插件 ──────────────────────────────────────────────────
# 提供 dashboard 的「fnOS 授权」tab 与 fnos_auth_* 工具：在界面里填 IP/域名、
# 生成授权链接或二维码、粘贴一次性授权码，令牌落到该设备独立的 trim-cli
# profile。省掉「去 SSH 跑 trim-cli login」这一步。
#
# 插件放在 HERMES_HOME/plugins/（上游扫描 home/plugins 与 profiles/*/plugins），
# 不放源码树 —— 源码树在升级时会被覆盖。
deploy_bundled_plugin() {
    local name="$1"
    local src="${TRIM_APPDEST}/plugins/${name}"
    local dst="${DATA_DIR}/plugins/${name}"

    if [ ! -d "${src}" ]; then
        log_msg "未随包内置插件 ${name}，跳过"
        return 0
    fi

    # 部署到**两个**位置，缺一不可：
    #   ${DATA_DIR}/src/plugins/  —— 源码树里的 bundled 插件，dashboard tab
    #                                只有在这里才会被自动挂载
    #   ${DATA_DIR}/plugins/      —— 用户插件目录（get_hermes_home()/plugins），
    #                                给 PM 与 fnos_auth_* 工具用
    # 只放后者时 tab 不出现（实测），因为 bundled 与 user 插件走不同的发现路径。
    # 三个位置，各司其职（都是实测出来的）：
    #   src/plugins/         —— bundled 形态，Agent 侧插件发现（工具注册）
    #   plugins/<n>/desktop/ —— 统一包的 desktop half（RUNTIME door 之一）
    #   desktop-plugins/<n>/ —— RUNTIME door 之二，**webapp 前端实际扫描这个**，
    #                           dashboard tab 就靠它出现
    local dst_src="${DATA_DIR}/src/plugins/${name}"
    mkdir -p "${DATA_DIR}/plugins" "${DATA_DIR}/src/plugins" \
             "${DATA_DIR}/desktop-plugins" 2>/dev/null || true

    # 前端要的独立副本：plugin.js 直接放 desktop-plugins/<id>/
    if [ -f "${src}/desktop/plugin.js" ]; then
        local dst_dp="${DATA_DIR}/desktop-plugins/${name}"
        mkdir -p "${dst_dp}" 2>/dev/null || true
        if cp -f "${src}/desktop/plugin.js" "${dst_dp}/plugin.js" 2>/dev/null; then
            chmod a+rX "${dst_dp}" "${dst_dp}/plugin.js" 2>/dev/null || true
            log_msg "插件 ${name} 的 desktop half 已部署到 ${dst_dp}"
        fi
    fi

    local target
    for target in "${dst_src}" "${dst}"; do
        rm -rf "${target}"
        if cp -r "${src}" "${target}" 2>/dev/null; then
            # 只读加载即可：Hermes 设了 PYTHONDONTWRITEBYTECODE=1，不写 __pycache__
            chmod -R a+rX "${target}" 2>/dev/null || true
            log_msg "插件 ${name} 已部署到 ${target}"
        else
            log_msg "复制插件 ${name} 到 ${target} 失败，跳过"
        fi
    done
    return 0
}

# 遍历部署全部随包插件（新增插件只需放进 packaging/fpk/app/plugins/）
deploy_bundled_plugins() {
    local d
    for d in "${TRIM_APPDEST}"/plugins/*/; do
        [ -d "${d}" ] || continue
        deploy_bundled_plugin "$(basename "${d}")"
    done
    return 0
}

deploy_fnos_skill() {
    local src="${TRIM_APPDEST}/skills/fnos-trim"
    local dst="${DATA_DIR}/skills/fnos-trim"

    if [ ! -d "${src}" ]; then
        log_msg "未随包内置飞牛 Skill，跳过（可在设置里手动安装）"
        return 0
    fi

    mkdir -p "${DATA_DIR}/skills" 2>/dev/null || true
    rm -rf "${dst}"
    if ! cp -r "${src}" "${dst}" 2>/dev/null; then
        log_msg "复制飞牛 Skill 失败，跳过"
        return 0
    fi

    # 只保留与本机架构匹配的二进制
    local arch target
    arch="$(uname -m)"
    case "${arch}" in
    x86_64)  target="trim-cli-linux-x64" ;;
    aarch64) target="trim-cli-linux-arm64" ;;
    armv7l)  target="" ;;
    *)       target="" ;;
    esac

    local bin="${dst}/bin"
    if [ -n "${target}" ] && [ -f "${bin}/${target}" ]; then
        # 移除不匹配架构的二进制，减小占用
        find "${bin}" -type f ! -name "${target}" -delete 2>/dev/null || true
        chmod +x "${bin}/${target}" 2>/dev/null || true
        log_msg "飞牛 Skill 已部署（${target}）"
    else
        log_msg "当前架构 ${arch} 无匹配的 trim-cli 二进制，仅部署文档"
    fi

    chmod +x "${dst}/scripts/trim-cli" 2>/dev/null || true

    # 写一份授权指引：OAuth 必须由用户在浏览器里确认，Agent 不能代劳
    cat > "${DATA_DIR}/fnos-skill-setup.txt" <<EOF
飞牛 NAS 技能已内置，但还需要一次授权
========================================

Agent 通过 trim-cli 操作本机 fnOS。trim-cli 使用 OAuth 2.0（PKCE），
首次使用需由你本人在浏览器中确认授权，Agent 不能代填账号密码。

授权步骤（在本机或任意能访问 NAS 的浏览器中执行）：

  1. 生成授权链接：
     ${dst}/scripts/trim-cli login --no-open

     该命令会打印一个 http://<NAS_IP>:5666/signin?... 链接，
     复制到浏览器打开，在 fnOS 登录页确认授权。

  2. 把浏览器给出的 Authorization code 粘贴回命令的提示中。

  3. 验证：
     ${dst}/scripts/trim-cli system info

说明：
- scope 按模块申请，未授权的模块会提示需要重新登录。
- 授权后 token 存在 ~/.config/trim-cli/，随应用数据目录保留。
- 如需撤销：${dst}/scripts/trim-cli logout
- 建议遵循最小权限原则，仅授权确实需要的模块。
EOF
    chmod 600 "${DATA_DIR}/fnos-skill-setup.txt" 2>/dev/null || true
    log_msg "授权指引已写入 ${DATA_DIR}/fnos-skill-setup.txt"
    return 0
}

# 部署后的校验与重试。
# 竞态：editable 安装的 postinstall 钩子会在安装结束后铺开 Hermes 内置技能，
# 可能覆盖刚部署的 skills/ 目录。首次安装时这个竞态真实发生过，
# 所以这里做「部署 → 校验 → 不在就重试」的兜底。
verify_fnos_skill() {
    local dst="${DATA_DIR}/skills/fnos-trim"
    local i
    for i in 1 2 3; do
        if [ -f "${dst}/SKILL.md" ] && [ -d "${dst}/bin" ] && [ -x "${dst}/scripts/trim-cli" ]; then
            log_msg "飞牛 Skill 校验通过"
            return 0
        fi
        log_msg "飞牛 Skill 校验未通过（第 ${i} 次），重新部署"
        deploy_fnos_skill
        sleep 2
    done
    log_msg "警告：飞牛 Skill 未能稳定部署，功能可能不可用"
    return 1
}

# 安装时先写配置、后建 venv，因此首次安装拿不到 scrypt 哈希，
# apply_wizard_settings 会回退 host=127.0.0.1（仅本机）。依赖装好后在这里补一次：
# 生成哈希 → 改为 0.0.0.0 → 写入 dashboard.basic_auth，恢复局域网直连。
finalize_webapp_auth() {
    local cfg="${CONFIG_FILE}"
    [ -f "${cfg}" ] || return 0
    local cur_host
    cur_host="$(sed -n 's/^[[:space:]]*host:[[:space:]]*//p' "${cfg}" 2>/dev/null \
        | head -n 1 | tr -d '"[:space:]')"
    if [ "${cur_host}" != "127.0.0.1" ] && [ "${cur_host}" != "localhost" ]; then
        return 0
    fi
    if grep -qE '^[[:space:]]*basic_auth:' "${cfg}" 2>/dev/null; then
        return 0
    fi

    local pass="${wizard_web_pass:-}"
    if [ -z "${pass}" ] && [ -f "${ACCESS_INFO}" ]; then
        pass="$(sed -n 's/^密码:[[:space:]]*//p' "${ACCESS_INFO}" 2>/dev/null | head -n 1)"
    fi
    [ -n "${pass}" ] || { log_msg "未拿到向导密码，保持 host=127.0.0.1"; return 0; }

    local hash=""
    if [ -x "${VENV_DIR}/bin/python3" ]; then
        hash="$(HERMES_PW="${pass}" \
            env HOME="${TRIM_PKGHOME:-${DATA_DIR}}" \
                HERMES_HOME="${DATA_DIR}" \
                PYTHONPATH="${SRC_DIR}" \
                "${VENV_DIR}/bin/python3" -c \
                'import os; from plugins.dashboard_auth.basic import hash_password; print(hash_password(os.environ["HERMES_PW"]))' \
            2>>"${LOG_FILE}" | tail -n 1)"
    fi
    if [ -z "${hash}" ]; then
        log_msg "补写认证失败：仍保持 host=127.0.0.1（仅本机可访问）"
        return 0
    fi

    sed -i "s/^[[:space:]]*host:[[:space:]]*.*/  host: 0.0.0.0/" "${cfg}" 2>/dev/null || true
    cat >> "${cfg}" <<EOF

# 认证提供方（依赖装好后补写；绑 0.0.0.0 时必需）
dashboard:
  basic_auth:
    username: ${wizard_web_user:-admin}
    password_hash: "${hash}"
EOF
    chmod 600 "${cfg}" 2>/dev/null || true
    log_msg "已补写 dashboard.basic_auth，webapp 恢复绑定 0.0.0.0（局域网可访问）"
}

# ── 主流程 ──────────────────────────────────────────────────────────────
log_msg "=== install_callback 开始 ==="
log_msg "DATA_DIR=${DATA_DIR}"
log_msg "ETC_DIR=${ETC_DIR}"

prepare_layout

verify_webapp || exit 1
# 端口固定使用 manifest.service_port（不换端口：桌面入口与适配层都按它配置）
apply_wizard_settings || exit 1
ensure_uv || exit 1
fetch_source || exit 1
install_hermes || exit 1
finalize_webapp_auth
deploy_fnos_skill
deploy_bundled_plugins
verify_fnos_skill || log_msg "飞牛 Skill 部署校验未通过，但不影响主功能"

# 修复属主：应用以专用用户运行，确保数据目录与 etc 配置可读写
if [ -n "${TRIM_UID}" ] && [ -n "${TRIM_GID}" ]; then
    chown -R "${TRIM_UID}:${TRIM_GID}" "${DATA_DIR}" 2>/dev/null || true
    chown -R "${TRIM_UID}:${TRIM_GID}" "${ETC_DIR}" 2>/dev/null || true
fi
# etc 内的敏感文件保持 0600（contract §3.2）
chmod 600 "${CONFIG_FILE}" "${ACCESS_INFO}" "${GATEWAY_CONF_ETC}" 2>/dev/null || true

log_msg "=== install_callback 完成 ==="
exit 0
